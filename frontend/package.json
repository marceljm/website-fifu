{
  "name": "demosuite-marketing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "react-router build",
    "preview": "react-router-serve ./build/server/index.js",
    "format": "prettier --write app/**/*.{ts,tsx,css} *.ts *.json",
    "format:check": "prettier --check app/**/*.{ts,tsx,css} *.ts *.json",
    "test:unit": "node --test tests/reviews.test.mjs tests/docs.test.mjs",
    "test:e2e": "node --test tests/site.e2e.mjs"
  },
  "dependencies": {
    "@react-router/dev": "^7.6.2",
    "@react-router/node": "^7.6.2",
    "@react-router/serve": "^7.6.2",
    "isbot": "^5.1.28",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "prettier": "^3.9.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
